# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto Supabase.
# Onde achar: painel do Supabase > Settings (engrenagem) > API.
# O `.env.local` é ignorado pelo Git — nunca vai pro GitHub.

# URL do projeto (ex.: https://xxxxxxxx.supabase.co) — pública.
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — feita para o navegador, protegida pelo RLS. Pode ser pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key (sb_secret_...) — SECRETA, só servidor. Escreve em guests/claims.
SUPABASE_SERVICE_ROLE_KEY=

# PIX do recebedor (S4). Chave = e-mail/telefone/CPF/aleatória cadastrada no banco.
# Nome e cidade: SEM acento, MAIÚSCULAS, curtos (<=25 e <=15 caracteres).
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
